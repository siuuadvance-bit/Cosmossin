{
  "appId": "com.cosmossin.app",
  "appName": "CosmosSim",
  "webDir": "www",
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
